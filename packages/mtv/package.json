{
  "name": "@caixax/mtv",
  "version": "0.0.0",
  "description": "Parser for Momentum Mod replay files (.mtv, MomentumTV). Zero dependencies, works in browsers, workers and Node.",
  "author": "caixax <westlargo@proton.me>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "momentum-mod",
    "replay",
    "mtv",
    "momentumtv",
    "parser",
    "source-engine",
    "speedrun"
  ]
}
