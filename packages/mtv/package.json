{
  "name": "@caixax/mtv",
  "version": "0.1.0",
  "description": "Parser for Momentum Mod replay files (.momtv, MomentumTV). Zero dependencies, works in browsers, workers and Node.",
  "author": "caixax <westlargo@proton.me>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "momentum-mod",
    "replay",
    "mtv",
    "momentumtv",
    "parser",
    "source-engine",
    "speedrun"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caixax/mtv.js.git",
    "directory": "packages/mtv"
  },
  "homepage": "https://github.com/caixax/mtv.js/tree/main/packages/mtv#readme",
  "bugs": {
    "url": "https://github.com/caixax/mtv.js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
