{
  "name": "@caixax/momtv-player",
  "version": "0.1.1",
  "description": "Drop-in player for Momentum Mod replays: the viewer with a loading screen, playback controls and a run HUD",
  "author": "caixax <westlargo@proton.me>",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./bundle": "./dist/momtv-player.global.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@caixax/momtv": "workspace:*",
    "@caixax/momtv-viewer": "workspace:*"
  },
  "keywords": [
    "momentum-mod",
    "replay",
    "mtv",
    "player",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caixax/momtv.js.git",
    "directory": "packages/player"
  },
  "homepage": "https://github.com/caixax/momtv.js/tree/main/packages/player#readme",
  "bugs": {
    "url": "https://github.com/caixax/momtv.js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
